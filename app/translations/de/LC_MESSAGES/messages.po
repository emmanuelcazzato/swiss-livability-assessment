#: app/templates/explore.html:115
msgid ""
"Average daylight exceeds EN 17037 target (>=2.0 klx) - Bright, well-lit "
"interiors."
msgstr ""
"Das durchschnittliche Tageslicht übertrifft das EN‑17037‑Ziel (≥2,0 klx) "
